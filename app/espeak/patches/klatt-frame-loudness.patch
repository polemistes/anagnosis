+// Anagnosis: the loudness of the spectrum frames (frame_t.rms), which the formant synthesiser
+// speaks through the formant heights and Klatt otherwise ignores, so that a trill's taps, a
+// flap and the closure of a voiced stop were all spoken at full voice. It is followed here as a
+// change of the voicing level in dB against the loudest vowel frames (rms 82 in eSpeak's data).
+#ifndef KLATT_RMS_PERCENT
+#define KLATT_RMS_PERCENT 100
+#endif
+static double rms_cur = 82, rms_inc = 0;
+
+static int rms_db(double rms)
+{
+	if (rms < 1) rms = 1;
+	double db = 20 * log10(rms / 82.0) * KLATT_RMS_PERCENT / 100;
+	if (db < -30) db = -30;
+	if (db > 3) db = 3;
+	return (int)db;
+}
