<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later; the same as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="notes.sqlite" />
        <include domain="sharedpref" path="anagnosis_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="notes.sqlite" />
        <include domain="sharedpref" path="anagnosis_settings.xml" />
    </device-transfer>
</data-extraction-rules>
