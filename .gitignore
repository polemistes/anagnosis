# Build outputs and downloaded upstream sources
pipeline/sources/
pipeline/build/
data/*.sqlite
data/*.sqlite.gz
data/*.sqlite.version
.venv/
__pycache__/
*.pyc

# Android / KMP
app/.gradle/
app/build/
app/*/build/
app/local.properties
app/.idea/
app/.kotlin/
*.iml
data/*.catalog.json

# Tesseract models (tessdata_best; see pipeline/tessdata/README.md)
pipeline/tessdata/*.traineddata

# Texts that may not be public before their release date (pipeline/anagnosis_pipeline/private.py):
# their files live in private/ (its own git repository); texts/<slug> and
# pipeline/transcriptions/drama/<slug> are links into it, ignored through the local
# .git/info/exclude. data/catalog-author.json is the local catalogue with every text;
# app/author-packs.txt is the local list of further asset packs to bundle. `check` reports a missing line.
/private/
/data/catalog-author.json
/app/author-packs.txt
